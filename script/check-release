#!/usr/bin/env python3
"""Validate a release tag against tracked version metadata."""

from __future__ import annotations

import json
import sys
import tomllib
from pathlib import Path


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: script/check-release v<version>", file=sys.stderr)
        return 2

    root = Path(__file__).resolve().parent.parent
    with (root / "pyproject.toml").open("rb") as handle:
        project_version = tomllib.load(handle)["project"]["version"]
    with (root / "custom_components" / "solarmax" / "manifest.json").open(
        encoding="utf-8"
    ) as handle:
        manifest_version = json.load(handle)["version"]

    if manifest_version != project_version:
        print(
            "manifest version "
            f"{manifest_version} does not match project version {project_version}",
            file=sys.stderr,
        )
        return 1

    tag = sys.argv[1]
    if tag != f"v{project_version}":
        print(
            f"release tag {tag} does not match source version {project_version}",
            file=sys.stderr,
        )
        return 1

    print(f"release metadata matches {tag}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
